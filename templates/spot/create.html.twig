{% extends 'base.html.twig' %}

{% block title %}Créer un lieu{% endblock %}

{% block body %}
    <main>
        <h1>Créer un nouveau lieu</h1>

        {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.address) }}
        {{ form_row(form.latitude) }}
        {{ form_row(form.longitude) }}

        {{ form_row(form.zipCode) }}
        {{ form_row(form.cityName) }}
        <button type="submit" class="btn btn-primary">Enregistrer le lieu</button>
        <a href="{{ path('hangout_publish') }}" class="btn btn-secondary">Annuler</a>

        {{ form_end(form) }}
    </main>
{% endblock %}
