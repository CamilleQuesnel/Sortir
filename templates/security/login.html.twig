{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <main id="login_main">
        <div id="login_form">
            <form method="post">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}


                <h1 class="h3 mb-3 font-weight-normal">Se connecter</h1>

                <div class="form-row">

                    <label for="identifier">{% if isMobile %}Mail{% else %}Identifiant{% endif %}</label>
                    <input type="text" value="{{ last_username }}" name="identifier" id="identifier" class="form-control"
                           autocomplete="username" required autofocus>
                </div>

                <div class="form-row">
                    <label for="inputPassword">Mot de passe</label>
                    <input type="password" name="password" id="inputPassword" class="form-control"
                           autocomplete="current-password" required>
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                           value="{{ csrf_token('authenticate') }}">
                </div>

                <div class="form-row actions">
                    <button type="submit">Connexion</button>
                    <label class="remember-me">
                        <input type="checkbox" name="_remember_me"> Se souvenir de moi
                    </label>
                    <a class="forgot-password" href="{{ path('app_forgotten_password') }}">Mot de passe oublié</a>
                </div>


            </form>
        </div>
    </main>
{% endblock %}
