{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    <h1 id="profile-h1">Mon profil - {{ app.user.pseudo | capitalize }}</h1>

    <div class="profile-wrapper">
        <div class="profile-avatar">
            <img src="{{ asset(app.user.image ? 'upload/images/' ~ app.user.image : 'upload/default-avatar.png') }}" alt="Avatar">

            {{ form_start(profileImageForm, {
                attr: { class: 'profile-form' },
                method: 'POST',
                enctype: 'multipart/form-data',
                action: path('app_profile_update_image')
            }) }}
            {{ form_row(profileImageForm.imageFile) }}
            <button type="submit" class="btn-action">Télécharger ma photo vers le serveur</button>
            {{ form_end(profileImageForm) }}
        </div>

        <div class="profile-info">
            <p><strong>Pseudo :</strong> {{ app.user.pseudo | capitalize}}</p>
            <p><strong>Prénom :</strong> {{ app.user.firstName | capitalize }}</p>
            <p><strong>Nom :</strong> {{ app.user.lastName | capitalize }}</p>
            <p><strong>Numéro de téléphone :</strong> {{ app.user.phoneNumber }}</p>
            <p><strong>Email :</strong> {{ app.user.mail }}</p>
            <p><strong>Campus :</strong> {{ app.user.campus.name }}</p>
        </div>
    </div>

    <div class="form-buttons">
        <a href="{{ path('app_profile_update') }}">
            <button type="button" class="btn-action">Modifier mes informations</button>
        </a>
    </div>
{% endblock %}

