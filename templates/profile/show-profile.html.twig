{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    <main class="content">
        <section class="hangout">
            <h1 id="profile-h1">Profil participant – {{ user.pseudo | capitalize }}</h1>

            <div class="profile-wrapper">
                <div class="profile-avatar">
                    <img src="{{ asset(app.user.image ? 'upload/images/' ~ app.user.image : 'upload/default-avatar.png') }}" alt="Avatar">
                    {% if app.user.image %}
                        <p>{{ app.user.image }}</p>
                    {% endif %}
                </div>

                <div class="profile-info">
                    <p><strong>Prénom :</strong> {{ user.firstName | capitalize }}</p>
                    <p><strong>Nom :</strong> {{ user.lastName | capitalize }}</p>
                    <p><strong>Email :</strong> {{ user.mail }}</p>
                    <p><strong>Numéro de téléphone :</strong> {{ user.phoneNumber }}</p>
                    <p><strong>Campus :</strong> {{ user.campus.name }}</p>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
