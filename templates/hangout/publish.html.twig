{% extends 'base.html.twig' %}


{% block body %}
    <main id="create-hangout">
        <h1>Créer une sortie</h1>
        <div class="content">
            <div class="hangout">
                {{ form_start(createHangoutForm) }}
                <div class="hangout-grid">
                    <div class="left-column">
                        {{ form_row(createHangoutForm.name) }}
                        {{ form_row(createHangoutForm.startingDate) }}
                        {{ form_row(createHangoutForm.registrationDeadline) }}
                        {{ form_row(createHangoutForm.duration) }}
                        {{ form_row(createHangoutForm.nbInscriptionsMax) }}
                        {{ form_row(createHangoutForm.description) }}
                    </div>
                    <div class="right-column">
                        <div class="spot-select">
                            {{ form_row(createHangoutForm.spot) }} <br>
                            <a href="{{ path('spot_create') }}" id="btn-spot-create">+</a>
                        </div>

                        <div class="spot-hangout">
                            <div id="spot-info">
                                <p>Rue : <span id="spot-address"></span></p>
                                <p>Latitude : <span id="spot-lat"></span></p>
                                <p>Longitude : <span id="spot-lng"></span></p>
                                <p>Code postal : <span id="spot-zip-code"></span></p>
                                <p>Ville : <span id="spot-city"></span></p>
                            </div>
                        </div>
                        <div class="action-buttons">
                            {{ form_widget(createHangoutForm.publish) }}
                            {{ form_widget(createHangoutForm.save) }}
                            {{ form_errors(createHangoutForm) }}
                            <a href="{{ path('hangout_index') }}" class="btn btn-primary">Annuler</a>
                        </div>
                    </div>

                </div>

                {{ form_end(createHangoutForm) }}
            </div>
        </div>

    </main>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/create-hangout.js') }}" defer></script>
    <script>
        window.spotSelectId = "{{ createHangoutForm.spot.vars.id }}";
        window.spotsData = {
            {% for spot in spots %}
            '{{ spot.id }}': {
                "address": "{{ spot.address|e('js') }}",
                "lat": "{{ spot.latitude }}",
                "lng": "{{ spot.longitude }}",
                "zipCode": "{{ spot.city.zipCode }}",
                "city": "{{ spot.city.name }}"
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        };
    </script>
{% endblock %}
