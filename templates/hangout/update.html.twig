{% extends 'base.html.twig' %}
{% block title %}
    Modifier une sortie
{% endblock %}

{% block body %}
    <main>
        <h1> Modifier une sortie</h1>
        <div>
            <div id="update_hangout">
                {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_row  (form.hangout.name) }}
                {{ form_row  (form.hangout.startingDate) }}
                {{ form_row  (form.hangout.registrationDeadline) }}
                {{ form_row  (form.hangout.duration) }}
                {{ form_row  (form.hangout.nbInscriptionsMax) }}
                {{ form_row  (form.hangout.description) }}
                {{ form_row(form.spot.name,{ 'label': false, 'attr': { 'style': 'display:none' } }) }}
                {{ form_row(form.spot.address,{ 'label': false, 'attr': { 'style': 'display:none' } }) }}
                <div class="spot-select">
                    {{ form_row  (form.hangout.spot) }}
                    <a href="{{ path('spot_create') }}" id="btn-spot-create">+</a>
                </div>

                <div id="spot-info">
                    <p>Address : <span id="spot-address">{{ spotForm.address }}</span></p>
                    <p>City : <span id="spot-city">{{ spotForm.city.name }}</span></p>
                    <p>Zip Code : <span id="spot-zip-code">{{ spotForm.city.zipCode }}</span></p>
                </div>
                {{ form_row  (form.spot.latitude) }}
                {{ form_row  (form.spot.longitude) }}
                {{ form_row(form._token) }}
                <button type="submit" class="btn btn-success">Valider</button>
                {{ form_end(form, {'render_rest': false}) }}
            </div>
            <div id="update_spot">

            </div>
            <div>
                <a href="">
                    <button class="btn btn-success">Publier la sortie</button>
                </a>
                <a href="">
                    <button class="btn btn-success">Supprimer la sortie</button>
                </a>
                <a href="">
                    <button class="btn btn-success">Annuler</button>
                </a>
            </div>
            {#                script js pour afficher dynamiquement les adresses du spot #}
            <script>

                const spotSelect = document.getElementById("{{ form.hangout.spot.vars.id }}");
                console.log('spotSelect:', spotSelect);
                const spotLatInput = document.getElementById("{{ form.spot.latitude.vars.id }}");
                const spotLngInput = document.getElementById("{{ form.spot.longitude.vars.id }}");
                const spotInfoDiv = document.getElementById("spot-info");
                const spotAddressSpan = document.getElementById("spot-address");
                const spotZipCodeSpan = document.getElementById("spot-zip-code");
                const spotCitySpan = document.getElementById("spot-city");

                // Liste des spots avec leurs infos (rendu côté client)
                const spotsData = {
                    {% for spot in spotALL %}
                    "{{ spot.id }}": {
                        "address": "{{ spot.address|e('js') }}",
                        "zipCode": "{{ spot.city.zipCode }}",
                        "city": "{{ spot.city.name }}",
                        "lat": "{{ spot.latitude }}",
                        "lng": "{{ spot.longitude }}"
                    }{% if not loop.last %},{% endif %}
                    {% endfor %}
                };

                spotSelect.addEventListener("change", function () {
                    const selectedId = this.value;
                    const data = spotsData[selectedId];

                    if (data) {
                        spotAddressSpan.textContent = data.address;
                        spotZipCodeSpan.textContent = data.zipCode;
                        spotCitySpan.textContent = data.city;
                        spotLatInput.value = data.lat;
                        spotLngInput.value = data.lng;
                        spotInfoDiv.style.display = "block";
                    } else {
                        spotInfoDiv.style.display = "none";
                    }
                });

            </script>
        </div>
    </main>
{% endblock %}


