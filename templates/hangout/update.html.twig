{% extends 'base.html.twig' %}
{% block title %}
    Update Hangout
{% endblock %}

{% block body %}
    <main>
        <h1>Update your Hangout</h1>
        <div>
            {{ form_start(createHangoutForm) }}
            {{ form_row(createHangoutForm.name) }}
            {{ form_row(createHangoutForm.startingDate) }}
            {{ form_row(createHangoutForm.registrationDeadline) }}
            {{ form_row(createHangoutForm.nbInscriptionsMax) }}
            {{ form_row(createHangoutForm.duration) }}
            {{ form_row(createHangoutForm.description) }}

            {{ form_end(createHangoutForm, {'render_rest': false}) }}
            {{  form_start(SpotForm) }}
            {{ form_end(SpotForm) }}
            <button type="submit">Update</button>
        </div>
        <div>

        </div>
    </main>
{% endblock %}


