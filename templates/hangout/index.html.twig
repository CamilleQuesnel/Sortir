{% extends 'base.html.twig' %}

 {% block title %}Hello HangoutController!{% endblock %}

{% block body %}
    <main id="hangout_main">
        <div id="hangout_date">
            <p>Date du jour : {{ "now"|date("d/m/Y") }}</p>
            <p>Participant : {{ app.user.firstName|capitalize }} {{ app.user.lastName|first|capitalize }}.</p>
        </div>
        <div class="filters_and_results">
            <section>
                {{ form_start(form) }}
                <div class="filters">
                    <div id="form_filters">
                        <h3>Filtrer les sorties</h3>
                        <div>
                            {{ form_label(form.campus) }}
                            {{ form_widget(form.campus) }}
                        </div>
                        <div>
                            {{ form_label(form.outputNameContains) }}
                            {{ form_widget(form.outputNameContains) }}
                        </div>
                        <div>
                            {{ form_label(form.dateFrom) }}
                            {{ form_widget(form.dateFrom) }}
                            {{ form_label(form.dateTo) }}
                            {{ form_widget(form.dateTo) }}
                        </div>
                    </div>
                    <div id="form_select">
                        <div>
                            {{ form_widget(form.isOrganizer) }}
                            {{ form_label(form.isOrganizer) }}
                        </div>
                        <div>
                            {{ form_widget(form.isRegistered) }}
                            {{ form_label(form.isRegistered) }}
                        </div>
                        <div>
                            {{ form_widget(form.isNotRegistered) }}
                            {{ form_label(form.isNotRegistered) }}
                        </div>
                        <div>
                            {{ form_widget(form.isPast) }}
                            {{ form_label(form.isPast) }}
                        </div>
                    </div>

                    <div id="btn-search">
                        {{ form_row(form.search) }}
                    </div>
                </div>
                {{ form_end(form) }}

            </section>
            <div>
                <section class="results">
                    <table class="table table-bordered table-striped">
                        <thead>
                        <tr>
                            <th>Nom de la sortie</th>
                            <th>Date de la sortie</th>
                            <th>Clôture</th>
                            <th>Inscrits / places</th>
                            <th>État</th>
                            <th>Inscrit</th>
                            <th>Organisateur</th>
                            <th>Campus</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for sortie in hangouts %}
                            <tr>
                            <td>{{ sortie.name }}</td>
                            <td>{{ sortie.startingDate|date('d/m/Y H:i') }}</td>
                            <td>{{ sortie.registrationDeadline|date('d/m/Y') }}</td>
                            {#                                app_profile_id REMPLACER DANS LA PATH EN DESSOUS #}
                            <td><a href="{{ path('app_profile_update') }}">{{ sortie.users|length }}
                                    /{{ sortie.nbInscriptionsMax }}</a></td>
                            <td>{{ sortie.status.label }}</td>
                            <td>
                                {% if app.user in sortie.users %}
                                    X
                                {% endif %}
                            </td>
                            <td>{{ sortie.organizer.firstname }} {{ sortie.organizer.lastname }}</td>
                            <td>{{ sortie.campus }}</td>
                            <td>

                            {% if sortie.status.label != 'Archivée' %}
                            <a href="{{ path('hangout_details', {'id': sortie.id}) }}">Afficher</a>
                            {% endif %}
                                {% if sortie.status.label == 'Créée' and sortie.organizer == app.user %}
                                    <a href="{{ path('hangout_update', {'id': sortie.id}) }}">Modifier</a> -
                                    <a href="{{ path('hangout_publish', {'id': sortie.id}) }}">Publier</a> -
                                    <a href="{{ path('hangout_details', {'id': sortie.id}) }}">Annuler</a>

                                {% elseif sortie.status.label == 'Ouverte' %}
                                    {% if sortie.organizer == app.user %}
                                        <a href="{{ path('hangout_update', {'id': sortie.id}) }}">Modifier</a> -
                                        <a href="{{ path('hangout_details', {'id': sortie.id}) }}">Annuler</a>
                                    {% endif %}

                                    {% if app.user in sortie.users %}
                                        <a href="{{ path('hangout_unsubscribe', {'id': sortie.id}) }}"> - Se désister</a>
                                    {% else %}
                                        <a href="{{ path('hangout_subscribe', {'id': sortie.id}) }}"> - S'inscrire</a>
                                    {% endif %}

                                {% elseif sortie.status.label == 'Fermée' %}
                                    {% if app.user in sortie.users %}
                                        <a href="{{ path('hangout_unsubscribe', {'id': sortie.id}) }}"> - Se désister</a>
                                    {% endif %}
                                    {% if sortie.organizer == app.user %}
                                        <a href="{{ path('hangout_details', {'id': sortie.id}) }}">Annuler</a>
                                    {% endif %}

                                {% elseif sortie.status.label == 'En cours' %}
                                    {% if app.user in sortie.users %}
                                        <a href="{{ path('hangout_unsubscribe', {'id': sortie.id}) }}"> - Se désister</a>
                                    {% endif %}

{#                                {% elseif sortie.status.label in ['Passée', 'Annulée'] %}#}
{#                                    <a href="{{ path('hangout_details', {'id': sortie.id}) }}">Afficher</a>#}
                                {% endif %}

                                </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="8">Aucune sortie trouvée.</td>
                                </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </section>
                <a href="{{ path('hangout_publish') }}"><button class="btn btn-primary" id="btn-create_hangout">Créer une sortie</button></a>
            </div>
        </div>

    </main>
{% endblock %}


