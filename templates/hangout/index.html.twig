{% extends 'base.html.twig' %}

{% block body %}
    <div class="flash-container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ label }}">

                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>
    <main id="hangout_main">
        {% if not isMobile %}
        <div id="hangout_date">
            <p>Date du jour : {{ "now"|date("d/m/Y") }}</p>
            <p>Participant : {{ app.user.firstName|capitalize }} {{ app.user.lastName|first|capitalize }}.</p>
        </div>
        <div class="filters_and_results">

                <section id="section_filter">
                    {{ form_start(form) }}
                    <div class="filters">
                        <div id="form_filters">
                            <h3>Filtrer les sorties</h3>
                            <div>
                                {{ form_label(form.campus) }}
                                {{ form_widget(form.campus) }}
                            </div>
                            <div>
                                {{ form_label(form.outputNameContains) }}
                                {{ form_widget(form.outputNameContains) }}
                            </div>
                            <div>
                                {{ form_label(form.dateFrom) }}
                                {{ form_widget(form.dateFrom) }}
                                {{ form_label(form.dateTo) }}
                                {{ form_widget(form.dateTo) }}
                            </div>
                        </div>
                        <div id="form_select">
                            <div>
                                {{ form_widget(form.isOrganizer) }}
                                {{ form_label(form.isOrganizer) }}
                            </div>
                            <div>
                                {{ form_widget(form.isRegistered) }}
                                {{ form_label(form.isRegistered) }}
                            </div>
                            <div>
                                {{ form_widget(form.isNotRegistered) }}
                                {{ form_label(form.isNotRegistered) }}
                            </div>
                            <div>
                                {{ form_widget(form.isPast) }}
                                {{ form_label(form.isPast) }}
                            </div>
                        </div>

                        <div id="btn-search">
                            {{ form_row(form.search) }}
                        </div>
                    </div>
                    {{ form_end(form) }}

                </section>
            {% endif %}

            {% if isMobile %}
                <h1>Mes sorties :</h1>
            {% endif %}
            <div class="results">

                <section class="custom-results ">
                    <table class="custom-table ">
                        <thead>
                        <tr>
                            <th class="col-name" >Nom de la sortie</th>
                            <th class="col-date" >Date de la sortie</th>
                            {% if isMobile %}
                                <th class="col-lieu" >Lieu</th>
                            {% else %}
                                <th class="col-deadline">Clôture</th>
                                <th class="col-inscriptions">Inscrits / places</th>
                                <th class="col-status">État</th>
                                <th class="col-is-registered">Inscrit</th>
                                <th class="col-organizer" >Organisateur</th>
                                <th class="col-campus" >Campus</th>
                                <th class="actionsTh">Actions</th>
                            {% endif %}
                        </tr>
                        </thead>
                        <tbody>
                        {% for item in hangoutWithCity %}
                            <tr>
                            <td class="col-name">
                                {% if isMobile %}
                                <a href="{{ path('hangout_details', {'id': item.hangout.id}) }}">
                                    {% endif %}
                                    {{ item.hangout.name }}
                                    {% if isMobile %}
                                </a>
                                {% endif %}
                            </td>
                            <td class="col-date">{{ item.hangout.startingDate|date('d/m/Y H:i') }}</td>
                            {% if isMobile %}
                                <td class="col-lieu">{{ item.city }}</td>
                            {% else %}
                                <td class="col-deadline">{{ item.hangout.registrationDeadline|date('d/m/Y') }}</td>
                                <td class="col-inscriptions"><a
                                        href="{{ path('app_profile_update') }}">{{ item.hangout.users|length }}
                                        /{{ item.hangout.nbInscriptionsMax }}</a></td>
                                <td class="col-status">{{ item.hangout.status.label }}</td>
                                <td class="col-is-registered">
                                    {% if app.user in item.hangout.users %}
                                        X
                                    {% endif %}
                                </td>
                                <td class="col-organizer">{{ item.hangout.organizer.firstname }} {{ item.hangout.organizer.lastname }}</td>
                                <td class="col-campus">{{ item.hangout.campus }}</td>
                                <td class="col-actions">
                                    {% if item.hangout.status.label != 'Archivée' %}
                                        <a href="{{ path('hangout_details', {'id': item.hangout.id}) }}"
                                           class="action-link view">Afficher</a>
                                    {% endif %}
                                    {% if item.hangout.status.label == 'Annulée' and item.hangout.organizer == app.user %}
                                        <a href="{{ path('hangout_update', {'id': item.hangout.id}) }}"  data-turbo="false"
                                           class="action-link edit">Modifier</a>
                                    {% endif %}
                                    {% if item.hangout.status.label == 'Créée' and item.hangout.organizer == app.user  %}
                                        <a href="{{ path('hangout_update', {'id': item.hangout.id}) }}"  data-turbo="false"
                                           class="action-link edit">Modifier</a>
                                        <a href="{{ path('hangout_publish', {'id': item.hangout.id}) }}"
                                           class="action-link publish">Publier</a>
                                        <a href="{{ path('hangout_delete', {'id': item.hangout.id}) }}"
                                           class="action-link cancel">Annuler</a>
                                    {% elseif item.hangout.status.label == 'Ouverte'  %}
                                        {% if item.hangout.organizer == app.user %}
                                            <a href="{{ path('hangout_update', {'id': item.hangout.id}) }}"  data-turbo="false"
                                               class="action-link edit">Modifier</a>
                                            <a href="{{ path('hangout_delete', {'id': item.hangout.id}) }}"
                                               class="action-link cancel">Annuler</a>
                                        {% endif %}
                                        {% if app.user in item.hangout.users %}
                                            <a href="{{ path('hangout_unsubscribe', {'id': item.hangout.id}) }}"
                                               class="action-link unsubscribe">Se désister</a>
                                        {% else %}
                                            <a href="{{ path('hangout_subscribe', {'id': item.hangout.id}) }}"
                                               class="action-link subscribe">S'inscrire</a>
                                        {% endif %}
                                    {% elseif item.hangout.status.label == 'Fermée' %}
                                        {% if app.user in item.hangout.users %}
                                            <a href="{{ path('hangout_unsubscribe', {'id': item.hangout.id}) }}"
                                               class="action-link unsubscribe">Se désister</a>
                                        {% endif %}
                                        {% if item.hangout.organizer == app.user %}
                                            <a href="{{ path('hangout_delete', {'id': item.hangout.id}) }}"
                                               class="action-link cancel">Annuler</a>
                                        {% endif %}
                                    {% elseif item.hangout.status.label == 'En cours' %}
                                        {% if app.user in item.hangout.users %}
                                            <a href="{{ path('hangout_unsubscribe', {'id': item.hangout.id}) }}"
                                               class="action-link unsubscribe">Se désister</a>
                                        {% endif %}
                                    {% endif %}
                                    {% if is_granted('ROLE_ADMIN') and item.hangout.status.label not in ['Archivée', 'Annulée', 'Passée'] and item.hangout.organizer != app.user %}
                                        <a href="{{ path('hangout_delete', {'id': item.hangout.id}) }}"
                                           class="action-link adminAnnuler">Annuler (admin)</a>
                                    {% endif %}
                                </td>
                                </tr>
                            {% endif %}
                        {% else %}
                            <tr>
                                <td colspan="9">Aucune sortie trouvée.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </section>
            </div>

            {% if not isMobile %}
                <a href="{{ path('hangout_publish') }}"  data-turbo="false">
                    <button class="btn btn-primary" id="btn-create_hangout">Créer une sortie</button>
                </a>
            {% endif %}
        </div>

    </main>
{% endblock %}


