{% extends 'base.html.twig' %}

{% block body %}
    <main>
        <h1>Liste des participants inscrits à la sortie :</h1>
        <section class="results">
            <table class="table table-bordered table-striped">
                <thead>
                <tr>
                    <th>Pseudo</th>
                    <th>Nom</th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td><a href="{{ path('app_profile_id', {'id': user.id}) }}">{{ user.pseudo }}</a></td>

                        <td>
                            <a href="{{ path('app_profile_id', {'id': user.id}) }}">{{ user.firstname }} {{ user.lastname }}</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2">Aucun participant</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </section>
    </main>
{% endblock %}
