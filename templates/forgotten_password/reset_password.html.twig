{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/forgotten.css') }}">
{% endblock %}
{% block body %}
    <main class="forgotten_main">
        <h1>Réinitialiser mon mot de passe</h1>
        <div class="forgotten_form">
            {{ form_start(form) }}
            {{ form_row(form.plainPassword) }}
            <div>
                <button class="btn btn-action">Mettre à jour</button>
            </div>
            {{ form_end(form) }}
        </div>
    </main>
{% endblock %}
