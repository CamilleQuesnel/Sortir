{% extends 'base.html.twig' %}

{% block body %}


    <h1 id="profile-h1">Créer un nouvel utilisateur</h1>

    <div class="profile-wrapper">
        <div class="profile-info">
            {{ form_start(createUser) }}
            {{ form_errors(createUser) }}

            <div class="profile-info-row">
                {{ form_row(createUser.pseudo) }}

            </div>

            <div class="profile-info-row">
                {{ form_row(createUser.firstName) }}
            </div>

            <div class="profile-info-row">
                {{ form_row(createUser.lastName) }}
            </div>

            <div class="profile-info-row">
                {{ form_row(createUser.phoneNumber) }}
            </div>

            <div class="profile-info-row">
                {{ form_row(createUser.mail) }}
            </div>

            <div class="profile-info-row">
                {{ form_row(createUser.plainPassword) }}
            </div>

            <div class="profile-info-row">
                {{ form_row(createUser.confirmPassword) }}
            </div>

            <div class="profile-info-row">
                {{ form_row(createUser.campus) }}
            </div>

            <div class="profile-info-row">
                {{ form_row(createUser.active) }}
            </div>

            <div class="profile-info-row">
                {{ form_row(createUser.isAdmin) }}
            </div>
            <div class="form-buttons">
                {{ form_row(createUser.save) }}
            </div>
            {{ form_end(createUser) }}

        </div>
    </div>
{% endblock %}
