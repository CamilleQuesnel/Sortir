{% extends 'base.html.twig' %}

{% block body %}
    <h1>Ajouter un nouveau campus</h1>

    {{ form_start(form, {
        attr: { class: 'centered-form' }
    }) }}
    {{ form_row(form.name) }}

    <button class="btn btn-primary">Ajouter le campus</button>
    {{ form_end(form) }}
    <div class="centered-button">
        <a href="{{ path('admin_campus') }}" class="btn btn-success">← Retour à la liste des campus</a>
    </div>
{% endblock %}
