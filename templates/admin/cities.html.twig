{% extends 'base.html.twig' %}

{% block title %}Liste des villes{% endblock %}

{% block body %}
    <h1>Villes actives</h1>
    <div class="centered-form">
        <form method="get" action="{{ path('admin_cities') }}" class="form-inline mb-3">
            <label for="search" class="me-2">Le nom contient :</label>
            <input type="text" id="search" name="search" value="{{ app.request.get('search') }}"
                   class="form-control me-2">
            <button type="submit" class="btn btn-outline-dark">Rechercher</button>
        </form>
    </div>

    <table class="custom-table">
        <thead>
        <tr>
            <th>Nom</th>
            <th>Code postal</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for city in cities %}
            <tr>
                <td>{{ city.name }}</td>
                <td>{{ city.zipCode }}</td>
                <td class="action-cell">
                    <a href="{{ path('admin_city_edit', {'id': city.id}) }}" class="btn-action">Modifier</a>

                    <form action="{{ path('admin_city_soft_delete', {'id': city.id}) }}" method="post"
                          onsubmit="return confirm('Supprimer cette ville ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ city.id) }}">
                        <button class="btn-action">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucune ville active.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="centered-button">
        <a href="{{ path('admin_city_add') }}" class="btn btn-success">+ Ajouter une ville</a>
    </div>
{% endblock %}
