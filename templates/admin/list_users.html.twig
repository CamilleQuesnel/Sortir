{% extends 'base.html.twig' %}

{% block body %}
    <h1>Gestion des comptes utilisateurs</h1>
    <section>
        <table class="custom-table">
            <thead>
            <tr>
                <th>Utilisateur</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.pseudo }} - {{ user.firstName }} {{ user.lastName }}</td>

                    <td>
                        {% if user.active %}
                            <a href="{{ path('admin_user_deactivate', {'id': user.id}) }}"
                               onclick="return confirm('Désactiver cet utilisateur ?');"
                               class="btn-action">Désactiver</a>
                        {% else %}
                            <span style="color: gray">Déjà désactivé</span>
                        {% endif %}
                    </td>

                    <td>
                        <form method="post"
                              action="{{ path('admin_user_delete', {'id': user.id}) }}"
                              onsubmit="return confirm('Confirmer la suppression de {{ user.pseudo }} ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                            <button class="btn-action" type="submit">Supprimer</button>
                        </form>
                    </td>
                </tr>
            </tbody>
            {% endfor %}
        </table>
    </section>
{% endblock %}
