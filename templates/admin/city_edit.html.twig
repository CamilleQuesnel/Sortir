{% extends 'base.html.twig' %}

{% block title %}Modifier la ville{% endblock %}

{% block body %}
    <h1>Modifier la ville</h1>

    {{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.zipCode) }}
    <button class="btn btn-primary">Mettre à jour</button>
    {{ form_end(form) }}

    <a href="{{ path('admin_cities') }}">← Retour à la liste des villes</a>
{% endblock %}
